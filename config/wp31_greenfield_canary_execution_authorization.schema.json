    "phase": {"enum": ["greenfield-canary-fast", "greenfield-preflight", "greenfield-backup-restore", "greenfield-deploy", "greenfield-inspect", "greenfield-rollback"]},
    "pro_review_evidence_sha256": {"pattern": "^([0-9a-f]{64})?$", "type": "string"},
