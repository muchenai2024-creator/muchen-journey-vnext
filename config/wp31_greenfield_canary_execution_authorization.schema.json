  "required": [
    "application_candidate_sha",
    "authorization_id",
    "authorization_status",
    "authorized_at_utc",
    "authorized_by",
    "authority",
    "environment",
    "max_allowlisted_learners",
    "not_after_utc",
    "ops_manifest_sha256",
    "phase",
    "pro_review_evidence_sha256",
    "production_job_execution_authorized",
    "release_go",
    "reviewed_ops_commit_sha",
    "reviewed_ops_ref",
    "worker_start_authorized"
